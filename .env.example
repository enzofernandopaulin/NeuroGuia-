# NeuroGuia - variáveis públicas do frontend
# Copie este arquivo para .env.local no desenvolvimento.
# No Vercel, cadastre as mesmas chaves em Project Settings > Environment Variables.

# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave ANON/PUBLISHABLE do Supabase.
# Esta chave pode ser usada no frontend quando as políticas RLS estão configuradas.
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE

# URL pública do app no Vercel. Atualize depois do primeiro deploy.
VITE_APP_URL=https://SEU-PROJETO.vercel.app

# Não coloque service_role, secret keys ou senhas administrativas em variáveis VITE_*.
